<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="401.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.ClientesController">
    <top>
        <Label text="Registro de Clientes" BorderPane.alignment="CENTER">
            <font>
                <Font size="31.0" />
            </font>
        </Label>
    </top>
    <center>
        <GridPane BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Cedula" GridPane.halignment="CENTER" />
                <TextField fx:id="txtCedula" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
                <Label text="Nombre" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                <Label text="Telefono" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                <Label text="Correo" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
                <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
            </children>
            <BorderPane.margin>
                <Insets left="10.0" right="10.0" />
            </BorderPane.margin>
        </GridPane>
    </center>
    <bottom>
        <TableView fx:id="tablaClientes" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colCedula" prefWidth="75.0" text="Cedula" />
                <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
                <TableColumn fx:id="colTelefono" prefWidth="75.0" text="Telefono" />
                <TableColumn fx:id="colCorreo" prefWidth="75.0" text="Correo" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </bottom>
    <right>
        <VBox alignment="CENTER" prefHeight="154.0" prefWidth="160.0" spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#registrarCliente" text="Registrar" />
                <Button mnemonicParsing="false" onAction="#modificarCliente" text="Modificar" />
                <Button mnemonicParsing="false" onAction="#eliminarCliente" text="Eliminar" />
                <Button mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar" />
            </children></VBox>
    </right>
</BorderPane>
