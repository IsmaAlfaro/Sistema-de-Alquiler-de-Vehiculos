<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            styleClass="page"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.ClientesController">

    <top>

        <VBox spacing="3.0"
              styleClass="page-header">

            <Label text="Clientes"
                   styleClass="page-title" />

            <Label text="Registro y gestión de clientes del sistema"
                   styleClass="page-subtitle" />

        </VBox>

    </top>

    <center>

        <VBox spacing="14.0">

            <padding>
                <Insets top="16.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <HBox spacing="18.0"
                  styleClass="card">

                <GridPane hgap="16.0"
                          vgap="12.0"
                          HBox.hgrow="ALWAYS">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="50.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="50.0" />

                    </columnConstraints>

                    <Label text="Cédula"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />

                    <Label text="Nombre completo"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

                    <TextField fx:id="txtCedula"
                               promptText="Ingrese la cédula"
                               prefHeight="34.0"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />

                    <TextField fx:id="txtNombre"
                               promptText="Ingrese el nombre completo"
                               prefHeight="34.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                    <Label text="Teléfono"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2" />

                    <Label text="Correo"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2" />

                    <TextField fx:id="txtTelefono"
                               promptText="Ingrese el teléfono"
                               prefHeight="34.0"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3" />

                    <TextField fx:id="txtCorreo"
                               promptText="Ingrese el correo electrónico"
                               prefHeight="34.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3" />

                </GridPane>

                <VBox alignment="TOP_CENTER"
                      spacing="9.0"
                      prefWidth="125.0"
                      styleClass="action-panel">

                    <Button text="Registrar"
                            mnemonicParsing="false"
                            onAction="#registrarCliente"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-primary" />

                    <Button text="Modificar"
                            mnemonicParsing="false"
                            onAction="#modificarCliente"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-secondary" />

                    <Button text="Eliminar"
                            mnemonicParsing="false"
                            onAction="#eliminarCliente"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-danger" />

                    <Button text="Limpiar"
                            mnemonicParsing="false"
                            onAction="#limpiarFormulario"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-secondary" />

                </VBox>

            </HBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="12.0"
                  styleClass="filter-card">

                <TextField fx:id="txtBuscar"
                           promptText="Buscar por cédula, nombre, teléfono o correo..."
                           prefHeight="35.0"
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS" />

            </HBox>

            <VBox spacing="8.0"
                  styleClass="card"
                  VBox.vgrow="ALWAYS">

                <Label text="Clientes registrados"
                       styleClass="section-title" />

                <TableView fx:id="tablaClientes"
                           prefHeight="300.0"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colCedula"
                                     prefWidth="140.0"
                                     text="Cédula" />

                        <TableColumn fx:id="colNombre"
                                     prefWidth="260.0"
                                     text="Nombre" />

                        <TableColumn fx:id="colTelefono"
                                     prefWidth="150.0"
                                     text="Teléfono" />

                        <TableColumn fx:id="colCorreo"
                                     prefWidth="260.0"
                                     text="Correo" />

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>