<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            styleClass="page"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.HistorialController">

    <top>

        <VBox spacing="3.0"
              styleClass="page-header">

            <Label text="Historial de Alquileres"
                   styleClass="page-title" />

            <Label text="Consulta de alquileres registrados, finalizados y generación de facturas"
                   styleClass="page-subtitle" />

        </VBox>

    </top>

    <center>

        <VBox spacing="14.0">

            <padding>
                <Insets top="16.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="12.0"
                  styleClass="filter-card">

                <VBox spacing="3.0"
                      HBox.hgrow="ALWAYS">

                    <Label text="Buscar"
                           styleClass="form-label" />

                    <TextField fx:id="txtBuscar"
                               promptText="Buscar por número, cliente, cédula, placa o vehículo..."
                               prefHeight="35.0"
                               styleClass="search-field"
                               maxWidth="Infinity" />

                </VBox>

                <VBox spacing="3.0">

                    <Label text="Estado"
                           styleClass="form-label" />

                    <ComboBox fx:id="cmbFiltroEstado"
                              prefWidth="150.0"
                              prefHeight="35.0" />

                </VBox>

                <VBox spacing="3.0">

                    <Label text="Factura"
                           styleClass="form-label" />

                    <Button text="Generar factura PDF"
                            mnemonicParsing="false"
                            onAction="#generarFactura"
                            prefHeight="35.0"
                            styleClass="button-primary" />

                </VBox>

            </HBox>

            <VBox spacing="8.0"
                  styleClass="card"
                  VBox.vgrow="ALWAYS">

                <Label text="Registro histórico"
                       styleClass="section-title" />

                <TableView fx:id="tablaHistorial"
                           prefHeight="400.0"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colNumero"
                                     prefWidth="70.0"
                                     text="Número" />

                        <TableColumn fx:id="colCliente"
                                     prefWidth="170.0"
                                     text="Cliente" />

                        <TableColumn fx:id="colVehiculo"
                                     prefWidth="170.0"
                                     text="Vehículo" />

                        <TableColumn fx:id="colFechaInicio"
                                     prefWidth="110.0"
                                     text="Inicio" />

                        <TableColumn fx:id="colFechaEsperada"
                                     prefWidth="120.0"
                                     text="Fecha esperada" />

                        <TableColumn fx:id="colFechaDevolucion"
                                     prefWidth="125.0"
                                     text="Devolución real" />

                        <TableColumn fx:id="colDias"
                                     prefWidth="65.0"
                                     text="Días" />

                        <TableColumn fx:id="colTotal"
                                     prefWidth="110.0"
                                     text="Total" />

                        <TableColumn fx:id="colEstado"
                                     prefWidth="100.0"
                                     text="Estado" />

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>