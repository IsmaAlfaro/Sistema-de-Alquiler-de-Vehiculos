<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.AlquileresController">

    <top>
        <VBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="18.0" />
            </padding>

            <Label text="Registro de Alquileres">
                <font>
                    <Font size="23.0" />
                </font>
            </Label>

            <Separator />
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>

            <GridPane hgap="12.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="110.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                    <ColumnConstraints halignment="RIGHT" minWidth="110.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbCliente" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Vehículo:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbVehiculo" prefWidth="250.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Fecha de inicio:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <DatePicker fx:id="dpFechaInicio" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Cantidad de días:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField fx:id="txtCantidadDias" promptText="Ejemplo: 3" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label text="Subtotal:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="lblSubtotal" text="₡0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Depósito:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                <Label fx:id="lblDeposito" text="₡0.00" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                <Label text="Total:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="lblTotal" text="₡0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Tarifa diaria del vehiculo -&gt;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label fx:id="lblTarifaDiaria" text="₡0.00" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER" spacing="12.0">
                <Button mnemonicParsing="false" onAction="#calcularAlquiler" text="Calcular" />

                <Button mnemonicParsing="false" onAction="#confirmarAlquiler" text="Confirmar alquiler" />

                <Button mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar" />
            </HBox>

            <Separator />

            <Label text="Alquileres registrados">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>

            <TableView fx:id="tablaAlquileres" prefHeight="300.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNumero" prefWidth="75.0" text="Número" />
                    <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                    <TableColumn fx:id="colVehiculo" prefWidth="140.0" text="Vehículo" />
                    <TableColumn fx:id="colFechaInicio" prefWidth="115.0" text="Fecha inicio" />
                    <TableColumn fx:id="colFechaEsperada" prefWidth="130.0" text="Fecha esperada" />
                    <TableColumn fx:id="colDias" prefWidth="75.0" text="Días" />
                    <TableColumn fx:id="colTotal" prefWidth="110.0" text="Total" />
                    <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
