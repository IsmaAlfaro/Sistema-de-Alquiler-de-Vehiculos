<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0"
            prefWidth="1000.0"
            styleClass="page"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.AlquileresController">

    <top>

        <VBox spacing="3.0"
              styleClass="page-header">

            <Label text="Registro de Alquileres"
                   styleClass="page-title" />

            <Label text="Creación y gestión de alquileres de vehículos"
                   styleClass="page-subtitle" />

        </VBox>

    </top>

    <center>

        <VBox spacing="14.0">

            <padding>
                <Insets top="16.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <VBox spacing="12.0"
                  styleClass="card">

                <Label text="Datos del alquiler"
                       styleClass="section-title" />

                <GridPane hgap="16.0"
                          vgap="10.0">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="50.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="50.0" />

                    </columnConstraints>

                    <Label text="Buscar cliente"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />

                    <Label text="Buscar vehículo"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

                    <TextField fx:id="txtBuscarCliente"
                               promptText="Cédula o nombre..."
                               prefHeight="34.0"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />

                    <TextField fx:id="txtBuscarVehiculo"
                               promptText="Placa, marca o modelo..."
                               prefHeight="34.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                    <Label text="Cliente"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2" />

                    <Label text="Vehículo"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2" />

                    <ComboBox fx:id="cmbCliente"
                              promptText="Seleccione..."
                              prefHeight="34.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="3" />

                    <ComboBox fx:id="cmbVehiculo"
                              promptText="Seleccione..."
                              prefHeight="34.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="3" />

                    <Label text="Fecha de inicio"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4" />

                    <Label text="Cantidad de días"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4" />

                    <DatePicker fx:id="dpFechaInicio"
                                prefHeight="34.0"
                                maxWidth="Infinity"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="5" />

                    <TextField fx:id="txtCantidadDias"
                               promptText="Ejemplo: 3"
                               prefHeight="34.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="5" />

                </GridPane>

            </VBox>

            <HBox spacing="12.0">

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Tarifa diaria"
                           styleClass="summary-label" />

                    <Label fx:id="lblTarifaDiaria"
                           text="₡0.00"
                           styleClass="summary-value" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Subtotal"
                           styleClass="summary-label" />

                    <Label fx:id="lblSubtotal"
                           text="₡0.00"
                           styleClass="summary-value" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Depósito"
                           styleClass="summary-label" />

                    <Label fx:id="lblDeposito"
                           text="₡0.00"
                           styleClass="summary-value" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card, summary-total-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Total"
                           styleClass="summary-label" />

                    <Label fx:id="lblTotal"
                           text="₡0.00"
                           styleClass="summary-total-value" />

                </VBox>

            </HBox>

            <VBox spacing="12.0"
                  styleClass="card">

                <Label text="Forma de pago"
                       styleClass="section-title" />

                <GridPane hgap="16.0"
                          vgap="8.0">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="30.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="30.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="12.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="28.0" />

                    </columnConstraints>

                    <Label text="Método de pago"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />

                    <Label text="Monto recibido"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

                    <Label text="Vuelto"
                           styleClass="form-label"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0" />

                    <ComboBox fx:id="cmbMetodoPago"
                              promptText="Seleccione..."
                              prefHeight="34.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1" />

                    <TextField fx:id="txtMontoRecibido"
                               promptText="Ejemplo: 250000"
                               prefHeight="34.0"
                               maxWidth="Infinity"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                    <Label fx:id="lblVuelto"
                           text="₡0.00"
                           styleClass="summary-total-value"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1" />

                    <HBox alignment="CENTER_RIGHT"
                          spacing="8.0"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="0"
                          GridPane.rowSpan="2">

                        <Button mnemonicParsing="false"
                                onAction="#calcularAlquiler"
                                text="Calcular"
                                prefHeight="35.0"
                                styleClass="button-secondary" />

                        <Button mnemonicParsing="false"
                                onAction="#confirmarAlquiler"
                                text="Confirmar alquiler"
                                prefHeight="35.0"
                                styleClass="button-primary" />

                        <Button mnemonicParsing="false"
                                onAction="#limpiarFormulario"
                                text="Limpiar"
                                prefHeight="35.0"
                                styleClass="button-secondary" />

                    </HBox>

                </GridPane>

                <Label text="Para pagos en efectivo, el monto recibido debe ser múltiplo de ₡10"
                       styleClass="page-subtitle" />

            </VBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="12.0"
                  styleClass="filter-card">

                <VBox spacing="3.0"
                      HBox.hgrow="ALWAYS">

                    <Label text="Buscar"
                           styleClass="form-label" />

                    <TextField fx:id="txtBuscarAlquiler"
                               promptText="Buscar por número, cliente, cédula o vehículo..."
                               prefHeight="35.0"
                               styleClass="search-field"
                               maxWidth="Infinity" />

                </VBox>

                <VBox spacing="3.0">

                    <Label text="Estado"
                           styleClass="form-label" />

                    <ComboBox fx:id="cmbFiltroEstado"
                              prefWidth="150.0"
                              prefHeight="35.0" />

                </VBox>

            </HBox>

            <VBox spacing="8.0"
                  styleClass="card"
                  VBox.vgrow="ALWAYS">

                <Label text="Alquileres registrados"
                       styleClass="section-title" />

                <TableView fx:id="tablaAlquileres"
                           prefHeight="300.0"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colNumero"
                                     prefWidth="75.0"
                                     text="Número" />

                        <TableColumn fx:id="colCliente"
                                     prefWidth="150.0"
                                     text="Cliente" />

                        <TableColumn fx:id="colVehiculo"
                                     prefWidth="150.0"
                                     text="Vehículo" />

                        <TableColumn fx:id="colFechaInicio"
                                     prefWidth="115.0"
                                     text="Fecha inicio" />

                        <TableColumn fx:id="colFechaEsperada"
                                     prefWidth="125.0"
                                     text="Fecha esperada" />

                        <TableColumn fx:id="colDias"
                                     prefWidth="70.0"
                                     text="Días" />

                        <TableColumn fx:id="colTotal"
                                     prefWidth="120.0"
                                     text="Total" />

                        <TableColumn fx:id="colEstado"
                                     prefWidth="100.0"
                                     text="Estado" />

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>