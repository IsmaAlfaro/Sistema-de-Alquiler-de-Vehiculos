<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            styleClass="page"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.InicioController">

   <top>

      <VBox spacing="3.0"
            styleClass="page-header">

         <Label text="Inicio"
                styleClass="page-title" />

         <Label text="Resumen general del sistema de alquiler de vehículos"
                styleClass="page-subtitle" />

      </VBox>

   </top>

   <center>

      <VBox spacing="18.0">

         <padding>
            <Insets top="22.0"
                    right="24.0"
                    bottom="24.0"
                    left="24.0" />
         </padding>

         <Label text="Resumen del sistema"
                styleClass="section-title" />

         <GridPane hgap="18.0"
                   vgap="18.0">

            <columnConstraints>

               <ColumnConstraints hgrow="ALWAYS"
                                  percentWidth="50.0" />

               <ColumnConstraints hgrow="ALWAYS"
                                  percentWidth="50.0" />

            </columnConstraints>

            <rowConstraints>

               <RowConstraints vgrow="ALWAYS" />

               <RowConstraints vgrow="ALWAYS" />

            </rowConstraints>


            <!-- TARJETA VEHÍCULOS -->

            <VBox alignment="CENTER_LEFT"
                  spacing="8.0"
                  styleClass="dashboard-card"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="0">

               <Label text="Cantidad de Vehículos"
                      styleClass="dashboard-card-title" />

               <Label fx:id="lblCantidadVehiculos"
                      text="0"
                      styleClass="dashboard-card-value" />

               <Label text="Vehículos registrados actualmente"
                      styleClass="dashboard-card-description" />

            </VBox>


            <!-- TARJETA DISPONIBLES -->

            <VBox alignment="CENTER_LEFT"
                  spacing="8.0"
                  styleClass="dashboard-card"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0">

               <Label text="Vehículos Disponibles"
                      styleClass="dashboard-card-title" />

               <Label fx:id="lblVehiculosDisponibles"
                      text="0"
                      styleClass="dashboard-card-value, dashboard-value-success" />

               <Label text="Vehículos disponibles para alquiler"
                      styleClass="dashboard-card-description" />

            </VBox>


            <!-- TARJETA CLIENTES -->

            <VBox alignment="CENTER_LEFT"
                  spacing="8.0"
                  styleClass="dashboard-card"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="1">

               <Label text="Clientes Registrados"
                      styleClass="dashboard-card-title" />

               <Label fx:id="lblCantidadClientes"
                      text="0"
                      styleClass="dashboard-card-value, dashboard-value-info" />

               <Label text="Clientes registrados en el sistema"
                      styleClass="dashboard-card-description" />

            </VBox>


            <!-- TARJETA ALQUILERES -->

            <VBox alignment="CENTER_LEFT"
                  spacing="8.0"
                  styleClass="dashboard-card"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="1">

               <Label text="Alquileres Activos"
                      styleClass="dashboard-card-title" />

               <Label fx:id="lblAlquileresActivos"
                      text="0"
                      styleClass="dashboard-card-value, dashboard-value-warning" />

               <Label text="Alquileres que se encuentran actualmente activos"
                      styleClass="dashboard-card-description" />

            </VBox>

         </GridPane>

         <VBox spacing="7.0"
               styleClass="dashboard-info-card">

            <Label text="Panel principal"
                   styleClass="section-title" />

            <Label text="Desde el menú lateral puede administrar vehículos, tipos de vehículos, clientes, alquileres, devoluciones e historial."
                   wrapText="true"
                   styleClass="page-subtitle" />

         </VBox>

      </VBox>

   </center>

</BorderPane>