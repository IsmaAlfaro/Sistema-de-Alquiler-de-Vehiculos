<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0"
            prefWidth="1000.0"
            styleClass="page"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.DevolucionController">

    <top>

        <VBox spacing="3.0"
              styleClass="page-header">

            <Label text="Devolución de Vehículos"
                   styleClass="page-title" />

            <Label text="Registro y cálculo de devoluciones de alquileres activos"
                   styleClass="page-subtitle" />

        </VBox>

    </top>

    <center>

        <VBox spacing="14.0">

            <padding>

                <Insets top="16.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />

            </padding>

            <VBox spacing="12.0"
                  styleClass="card">

                <Label text="Datos de la devolución"
                       styleClass="section-title" />

                <GridPane hgap="16.0"
                          vgap="10.0">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="50.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="50.0" />

                    </columnConstraints>

                    <Label text="Alquiler activo"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />

                    <Label text="Fecha de devolución"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

                    <ComboBox fx:id="cmbAlquiler"
                              promptText="Seleccione un alquiler..."
                              prefHeight="34.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1" />

                    <DatePicker fx:id="dpFechaDevolucion"
                                prefHeight="34.0"
                                maxWidth="Infinity"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1" />

                </GridPane>

            </VBox>

            <HBox spacing="12.0">

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Cliente"
                           styleClass="summary-label" />

                    <Label fx:id="lblCliente"
                           text="-"
                           wrapText="true"
                           styleClass="summary-value-small" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Vehículo"
                           styleClass="summary-label" />

                    <Label fx:id="lblVehiculo"
                           text="-"
                           wrapText="true"
                           styleClass="summary-value-small" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Fecha esperada"
                           styleClass="summary-label" />

                    <Label fx:id="lblFechaEsperada"
                           text="-"
                           styleClass="summary-value-small" />

                </VBox>

            </HBox>

            <HBox spacing="12.0">

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Días de atraso"
                           styleClass="summary-label" />

                    <Label fx:id="lblDiasAtraso"
                           text="0"
                           styleClass="summary-value" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Multa"
                           styleClass="summary-label" />

                    <Label fx:id="lblMulta"
                           text="₡0.00"
                           styleClass="summary-value" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Depósito devuelto"
                           styleClass="summary-label" />

                    <Label fx:id="lblDepositoDevuelto"
                           text="₡0.00"
                           styleClass="summary-value" />

                </VBox>

                <VBox spacing="5.0"
                      styleClass="summary-card summary-total-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="Saldo pendiente"
                           styleClass="summary-label" />

                    <Label fx:id="lblSaldoPendiente"
                           text="₡0.00"
                           styleClass="summary-total-value" />

                </VBox>

            </HBox>

            <HBox alignment="CENTER_RIGHT"
                  spacing="10.0">

                <Button text="Calcular devolución"
                        mnemonicParsing="false"
                        onAction="#calcularDevolucion"
                        prefHeight="35.0"
                        styleClass="button-secondary" />

                <Button text="Confirmar devolución"
                        mnemonicParsing="false"
                        onAction="#confirmarDevolucion"
                        prefHeight="35.0"
                        styleClass="button-primary" />

                <Button text="Limpiar"
                        mnemonicParsing="false"
                        onAction="#limpiarFormulario"
                        prefHeight="35.0"
                        styleClass="button-secondary" />

            </HBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="12.0"
                  styleClass="filter-card">

                <TextField fx:id="txtBuscarDevolucion"
                           promptText="Buscar por número, cliente, cédula, placa o vehículo..."
                           prefHeight="35.0"
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS" />

            </HBox>

            <VBox spacing="8.0"
                  styleClass="card"
                  VBox.vgrow="ALWAYS">

                <Label text="Alquileres activos"
                       styleClass="section-title" />

                <TableView fx:id="tablaAlquileresActivos"
                           prefHeight="260.0"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colNumero"
                                     prefWidth="80.0"
                                     text="Número" />

                        <TableColumn fx:id="colCliente"
                                     prefWidth="180.0"
                                     text="Cliente" />

                        <TableColumn fx:id="colVehiculo"
                                     prefWidth="190.0"
                                     text="Vehículo" />

                        <TableColumn fx:id="colFechaInicio"
                                     prefWidth="130.0"
                                     text="Fecha de inicio" />

                        <TableColumn fx:id="colFechaEsperada"
                                     prefWidth="140.0"
                                     text="Fecha esperada" />

                        <TableColumn fx:id="colEstado"
                                     prefWidth="110.0"
                                     text="Estado" />

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>