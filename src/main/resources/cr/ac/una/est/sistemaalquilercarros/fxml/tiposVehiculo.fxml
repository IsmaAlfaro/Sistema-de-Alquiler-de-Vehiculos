<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.TiposVehiculoController">
    <top>
        <Label text="Gestión de Tipos de Vehículo" BorderPane.alignment="CENTER">
            <font>
                <Font size="30.0" />
            </font>
        </Label>
    </top>
    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" top="5.0" />
            </BorderPane.margin>
            <children>
                <GridPane alignment="CENTER" prefHeight="34.0" prefWidth="730.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label alignment="CENTER" text="Nombre del tipo de Vehiculo:" GridPane.halignment="CENTER" />
                        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </GridPane>
                <GridPane prefHeight="87.0" prefWidth="750.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Categoría" GridPane.halignment="CENTER" />
                        <ComboBox fx:id="cmbCategoria" prefWidth="150.0" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
                <CheckBox fx:id="chkPasajeros" mnemonicParsing="false" prefHeight="17.0" prefWidth="174.0" text="Requiere pasajeros">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin></CheckBox>
                <CheckBox fx:id="chkTraccion" mnemonicParsing="false" prefHeight="17.0" prefWidth="174.0" text="Requiere tracción" />
                <CheckBox fx:id="chkCapacidadCarga" mnemonicParsing="false" text="Requiere capacidad de carga" />
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#registrarTipo" text="Registrar" />
                        <Button mnemonicParsing="false" onAction="#eliminarTipo" text="Eliminar" />
                        <Button mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <TableView fx:id="tablaTipos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoría" />
                <TableColumn fx:id="colPasajeros" prefWidth="75.0" text="Pasajeros" />
                <TableColumn fx:id="colTraccion" prefWidth="75.0" text="Tracción" />
                <TableColumn fx:id="colCarga" prefWidth="75.0" text="Carga" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </bottom>
</BorderPane>
