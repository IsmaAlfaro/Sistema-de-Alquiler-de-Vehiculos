<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane fx:id="panelPrincipal"
            prefHeight="700.0"
            prefWidth="1100.0"
            styleClass="main-root"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.PrincipalController">

   <top>

      <StackPane prefHeight="78.0"
                 styleClass="main-topbar">

         <!-- =========================
              PATRÓN DECORATIVO
              ========================= -->

         <Pane mouseTransparent="true">

            <Line startX="560.0"
                  startY="0.0"
                  endX="500.0"
                  endY="78.0"
                  stroke="rgba(255,255,255,0.08)"
                  strokeWidth="18.0" />

            <Line startX="690.0"
                  startY="0.0"
                  endX="630.0"
                  endY="78.0"
                  stroke="rgba(255,255,255,0.06)"
                  strokeWidth="18.0" />

            <Line startX="820.0"
                  startY="0.0"
                  endX="760.0"
                  endY="78.0"
                  stroke="rgba(255,255,255,0.05)"
                  strokeWidth="18.0" />

            <Line startX="950.0"
                  startY="0.0"
                  endX="890.0"
                  endY="78.0"
                  stroke="rgba(255,255,255,0.04)"
                  strokeWidth="18.0" />

         </Pane>

         <!-- =========================
              CONTENIDO DE LA BARRA
              ========================= -->

         <HBox alignment="CENTER_LEFT"
               spacing="12.0">

            <padding>
               <Insets left="28.0"
                       right="28.0" />
            </padding>

            <VBox spacing="3.0"
                  alignment="CENTER_LEFT">

               <Label text="XANTIUM"
                      styleClass="main-system-title" />

               <Label text="Sistema de alquiler de vehículos"
                      styleClass="main-system-subtitle" />

            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label text="Proyecto Programación 3"
                   styleClass="main-project-label" />

         </HBox>

      </StackPane>

   </top>

   <left>

      <VBox prefWidth="210.0"
            spacing="6.0"
            styleClass="sidebar">

         <padding>
            <Insets bottom="18.0"
                    left="12.0"
                    right="12.0"
                    top="18.0" />
         </padding>

         <!-- LOGO DEL SISTEMA -->
         <HBox alignment="CENTER">

            <ImageView fitHeight="175.0"
                       fitWidth="175.0"
                       preserveRatio="true">

               <image>
                  <Image url="@../img/logo.png" />
               </image>

            </ImageView>

         </HBox>

         <VBox spacing="2.0"
               styleClass="sidebar-header">

            <Label styleClass="sidebar-title"
                   text="Menú principal" />

            <Label styleClass="sidebar-subtitle"
                   text="Gestión del sistema" />

         </VBox>

         <Separator />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#mostrarInicio"
                 prefHeight="40.0"
                 styleClass="nav-button"
                 text="Inicio" />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#mostrarVehiculos"
                 prefHeight="40.0"
                 styleClass="nav-button"
                 text="Vehículos" />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#mostrarTiposVehiculo"
                 prefHeight="40.0"
                 styleClass="nav-button"
                 text="Tipos de Vehículos" />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#mostrarClientes"
                 prefHeight="40.0"
                 styleClass="nav-button"
                 text="Clientes" />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#mostrarAlquileres"
                 prefHeight="40.0"
                 styleClass="nav-button"
                 text="Alquileres" />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#mostrarDevolucion"
                 prefHeight="40.0"
                 styleClass="nav-button"
                 text="Devoluciones" />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#mostrarHistorial"
                 prefHeight="40.0"
                 styleClass="nav-button"
                 text="Historial" />

         <Region VBox.vgrow="ALWAYS" />

         <Separator />

         <Button maxWidth="Infinity"
                 mnemonicParsing="false"
                 onAction="#cerrarAplicacion"
                 prefHeight="40.0"
                 styleClass="nav-button-exit"
                 text="Salir" />

      </VBox>

   </left>

   <center>

      <StackPane styleClass="main-content">

         <VBox alignment="CENTER"
               maxWidth="520.0"
               spacing="10.0"
               styleClass="welcome-card">

            <Label styleClass="welcome-title"
                   text="Sistema de Alquiler de Vehículos" />

            <Label styleClass="welcome-subtitle"
                   text="Seleccione una opción del menú lateral para comenzar"
                   wrapText="true" />

            <Separator />

            <Label styleClass="welcome-description"
                   text="Administre vehículos, clientes, alquileres, devoluciones e historial desde un solo lugar"
                   wrapText="true" />

         </VBox>

      </StackPane>

   </center>

</BorderPane>