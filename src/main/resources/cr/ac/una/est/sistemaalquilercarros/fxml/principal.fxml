<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="panelPrincipal"
            prefHeight="700.0"
            prefWidth="1100.0"
            styleClass="main-root"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.PrincipalController">

   <top>

      <HBox alignment="CENTER_LEFT"
            prefHeight="58.0"
            styleClass="main-topbar">

         <padding>
            <Insets left="22.0"
                    right="22.0" />
         </padding>

         <Label text="Sistema Alquiler de Vehículos"
                styleClass="main-system-title" />

      </HBox>

   </top>

   <left>

      <VBox prefWidth="210.0"
            spacing="6.0"
            styleClass="sidebar">

         <padding>
            <Insets top="18.0"
                    right="12.0"
                    bottom="18.0"
                    left="12.0" />
         </padding>

         <VBox spacing="2.0"
               styleClass="sidebar-header">

            <Label text="Menú principal"
                   styleClass="sidebar-title" />

            <Label text="Gestión del sistema"
                   styleClass="sidebar-subtitle" />

         </VBox>

         <Separator />

         <Button text="Inicio"
                 mnemonicParsing="false"
                 onAction="#mostrarInicio"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button" />

         <Button text="Vehículos"
                 mnemonicParsing="false"
                 onAction="#mostrarVehiculos"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button" />

         <Button text="Tipos de Vehículos"
                 mnemonicParsing="false"
                 onAction="#mostrarTiposVehiculo"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button" />

         <Button text="Clientes"
                 mnemonicParsing="false"
                 onAction="#mostrarClientes"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button" />

         <Button text="Alquileres"
                 mnemonicParsing="false"
                 onAction="#mostrarAlquileres"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button" />

         <Button text="Devoluciones"
                 mnemonicParsing="false"
                 onAction="#mostrarDevolucion"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button" />

         <Button text="Historial"
                 mnemonicParsing="false"
                 onAction="#mostrarHistorial"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button" />

         <Region VBox.vgrow="ALWAYS" />

         <Separator />

         <Button text="Salir"
                 mnemonicParsing="false"
                 onAction="#cerrarAplicacion"
                 maxWidth="Infinity"
                 prefHeight="40.0"
                 styleClass="nav-button-exit" />

      </VBox>

   </left>

   <center>

      <StackPane styleClass="main-content">

         <VBox alignment="CENTER"
               spacing="10.0"
               maxWidth="520.0"
               styleClass="welcome-card">

            <Label text="Sistema de Alquiler de Vehículos"
                   styleClass="welcome-title" />

            <Label text="Seleccione una opción del menú lateral para comenzar"
                   wrapText="true"
                   styleClass="welcome-subtitle" />

            <Separator />

            <Label text="Administre vehículos, clientes, alquileres, devoluciones e historial desde un solo lugar"
                   wrapText="true"
                   styleClass="welcome-description" />

         </VBox>

      </StackPane>

   </center>

</BorderPane>