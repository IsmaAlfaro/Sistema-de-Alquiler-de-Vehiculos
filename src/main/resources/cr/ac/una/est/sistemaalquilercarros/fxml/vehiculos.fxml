<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            styleClass="page"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.sistemaalquilercarros.controlador.VehiculosController">

    <top>

        <VBox spacing="3.0"
              styleClass="page-header">

            <Label text="Vehículos"
                   styleClass="page-title" />

            <Label text="Registro y gestión de vehículos del sistema"
                   styleClass="page-subtitle" />

        </VBox>

    </top>

    <center>

        <VBox spacing="14.0">

            <padding>
                <Insets top="16.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <HBox spacing="18.0"
                  styleClass="card">

                <GridPane hgap="12.0"
                          vgap="10.0"
                          HBox.hgrow="ALWAYS">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="25.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="25.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="25.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           percentWidth="25.0" />

                    </columnConstraints>

                    <Label text="Placa"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />

                    <Label text="Marca"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

                    <Label text="Modelo"
                           styleClass="form-label"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0" />

                    <Label text="Año"
                           styleClass="form-label"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0" />

                    <TextField fx:id="txtPlaca"
                               prefHeight="34.0"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />

                    <TextField fx:id="txtMarca"
                               prefHeight="34.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                    <TextField fx:id="txtModelo"
                               prefHeight="34.0"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="1" />

                    <TextField fx:id="txtAnio"
                               prefHeight="34.0"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1" />

                    <Label text="Buscar tipo"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2" />

                    <Label text="Tipo de Vehículo"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2" />

                    <Label text="Tarifa diaria"
                           styleClass="form-label"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="2" />

                    <Label text="Cantidad de pasajeros"
                           styleClass="form-label"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="2" />

                    <TextField fx:id="txtBuscarTipo"
                               promptText="Buscar tipo..."
                               prefHeight="34.0"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3" />

                    <ComboBox fx:id="cmbTipo"
                              promptText="Seleccione..."
                              prefHeight="34.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="3" />

                    <TextField fx:id="txtTarifa"
                               promptText="Ejemplo: 35000"
                               prefHeight="34.0"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="3" />

                    <TextField fx:id="txtPasajeros"
                               prefHeight="34.0"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="3" />

                    <Label text="Tipo de tracción"
                           styleClass="form-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4" />

                    <Label text="Capacidad de carga"
                           styleClass="form-label"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4" />

                    <ComboBox fx:id="cmbTraccion"
                              prefHeight="34.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="5" />

                    <TextField fx:id="txtCapacidadCarga"
                               prefHeight="34.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="5" />

                </GridPane>

                <VBox alignment="TOP_CENTER"
                      spacing="9.0"
                      prefWidth="125.0"
                      styleClass="action-panel">

                    <Button text="Registrar"
                            mnemonicParsing="false"
                            onAction="#registrarVehiculo"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-primary" />

                    <Button text="Modificar"
                            mnemonicParsing="false"
                            onAction="#modificarVehiculo"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-secondary" />

                    <Button text="Eliminar"
                            mnemonicParsing="false"
                            onAction="#eliminarVehiculo"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-danger" />

                    <Button text="Limpiar"
                            mnemonicParsing="false"
                            onAction="#limpiarFormulario"
                            maxWidth="Infinity"
                            prefHeight="35.0"
                            styleClass="button-secondary" />

                </VBox>

            </HBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="12.0"
                  styleClass="filter-card">

                <VBox spacing="3.0"
                      HBox.hgrow="ALWAYS">

                    <Label text="Buscar"
                           styleClass="form-label" />

                    <TextField fx:id="txtBuscar"
                               promptText="Buscar por placa, marca, modelo o tipo..."
                               prefHeight="35.0"
                               styleClass="search-field"
                               maxWidth="Infinity" />

                </VBox>

                <VBox spacing="3.0">

                    <Label text="Estado"
                           styleClass="form-label" />

                    <ComboBox fx:id="cmbFiltroEstado"
                              prefWidth="150.0"
                              prefHeight="35.0" />

                </VBox>

            </HBox>

            <VBox spacing="8.0"
                  styleClass="card"
                  VBox.vgrow="ALWAYS">

                <Label text="Vehículos registrados"
                       styleClass="section-title" />

                <TableView fx:id="tablaVehiculos"
                           prefHeight="300.0"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colPlaca"
                                     prefWidth="100.0"
                                     text="Placa" />

                        <TableColumn fx:id="colMarca"
                                     prefWidth="120.0"
                                     text="Marca" />

                        <TableColumn fx:id="colModelo"
                                     prefWidth="130.0"
                                     text="Modelo" />

                        <TableColumn fx:id="colAnio"
                                     prefWidth="80.0"
                                     text="Año" />

                        <TableColumn fx:id="colTipo"
                                     prefWidth="130.0"
                                     text="Tipo" />

                        <TableColumn fx:id="colTarifa"
                                     prefWidth="150.0"
                                     text="Tarifa Diaria" />

                        <TableColumn fx:id="colEstado"
                                     prefWidth="120.0"
                                     text="Estado" />

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>